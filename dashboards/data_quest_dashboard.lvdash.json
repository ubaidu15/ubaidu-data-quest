{
  "datasets": [
    {
      "name": "ds_q1",
      "displayName": "Q1 \u00b7 Population stats 2013\u20132018",
      "queryLines": [
        "SELECT years_count, mean_population, stddev_population_sample, stddev_population_pop FROM workspace.data_quest.gold_q1_population_stats"
      ]
    },
    {
      "name": "ds_pop",
      "displayName": "US population by year",
      "queryLines": [
        "SELECT year, population FROM workspace.data_quest.silver_population ORDER BY year"
      ]
    },
    {
      "name": "ds_q2",
      "displayName": "Q2 \u00b7 Best year per series",
      "queryLines": [
        "SELECT series_id, series_label, sector_name, measure_text, duration_text, best_year, CAST(best_year_value AS DOUBLE) AS best_year_total, periods_in_best_year, value_basis FROM workspace.data_quest.gold_q2_series_best_year"
      ]
    },
    {
      "name": "ds_q3",
      "displayName": "Q3 \u00b7 Manufacturing hours (Q1) vs population",
      "queryLines": [
        "SELECT year, CAST(value AS DOUBLE) AS pct_change_q1, population FROM workspace.data_quest.gold_q3_prs30006032_q01_population ORDER BY year"
      ]
    },
    {
      "name": "ds_health",
      "displayName": "Data freshness",
      "queryLines": [
        "SELECT status, date_format(last_successful_refresh_at, 'yyyy-MM-dd HH:mm') AS last_refresh_utc, date_format(bls_source_last_modified, 'yyyy-MM-dd') AS bls_published FROM workspace.data_quest.ops_pipeline_health"
      ]
    }
  ],
